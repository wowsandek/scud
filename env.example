# Nginx port mapping (host:container)
# Если на сервере уже есть сайт на порту 80, используйте другой порт (например, 8080)
# Default: 80
NGINX_PORT=8080

# Backend API base URL (for reference only)
# The frontend uses localStorage for API settings
# Default backend URL: http://127.0.0.1:8081
API_BASE_URL=http://127.0.0.1:8081

